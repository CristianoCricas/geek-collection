    <!-- Settings -->
    <string name="settings_title">Configurações</string>
    <string name="settings_rawg_title">Chave da API RAWG (games)</string>
    <string name="settings_rawg_body">A RAWG é um banco de dados de video games. A chave é gratuita e pode ser criada em rawg.io/apidocs. Sem ela, os games são buscados na Wikipédia.</string>
    <string name="settings_rawg_hint">Cole sua chave aqui</string>
    <string name="settings_wikipedia_title">Idioma da Wikipédia</string>
    <string name="settings_wikipedia_body">Usado nas buscas genéricas (consoles, acessórios, action figures e colecionáveis).</string>
    <string name="settings_sources_title">Fontes de dados</string>
    <string name="settings_sources_body">Livros: Open Library · Jogos de tabuleiro: BoardGameGeek · Games: RAWG ou Wikipédia · Códigos de barras: UPCitemdb e Open Library · Outros: Wikipédia</string>
    <string name="settings_about_title">Sobre</string>
    <string name="settings_about_body">Geek Collection v%1$s. O reconhecimento de imagem roda no aparelho com ML Kit (código de barras, texto e rótulos). Nenhuma foto é enviada para a internet, apenas o texto reconhecido.</string>
    <string name="settings_saved">Configurações salvas</string>
    <string name="sync_title">Sincronização na nuvem</string>
    <string name="sync_body">Mantém a biblioteca igual em todos os seus aparelhos (app Android e PWA) usando o Firebase do Google, no plano gratuito. Só o que foi criado ou alterado desde a última sincronização é enviado ou recebido.</string>
    <string name="sync_setup">Como configurar (uma vez): 1) Crie um projeto em console.firebase.google.com. 2) Em Authentication → Sign-in method, ative E-mail/senha. 3) Crie o Firestore Database e cole as regras indicadas no README (users/{uid} só para o próprio usuário). 4) Em Configurações do projeto, copie o ID do projeto e a chave de API da Web.</string>
